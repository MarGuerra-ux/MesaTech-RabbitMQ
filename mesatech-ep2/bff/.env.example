# Copiar a .env (mismo directorio del jar) y completar. NO subir .env al repositorio.
SERVER_PORT=8080

# Entra ID: Id. de directorio (inquilino) e Id. de aplicación de api-cloud-native
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Catálogo en la misma EC2 A; Solicitudes por IP PRIVADA de la EC2 B
CATALOGO_URL=http://localhost:8081
SOLICITUDES_URL=http://10.0.0.20:8082

# Origen del frontend React (local y/o publicado)
CORS_ALLOWED_ORIGINS=http://localhost:3000
