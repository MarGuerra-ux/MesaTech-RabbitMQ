# Copiar a .env (mismo directorio del jar) y completar. NO subir .env al repositorio.
# Sin comillas y sin los caracteres # \ ni espacios en las claves.
SERVER_PORT=8082

# Endpoint de la instancia RDS exclusiva de Solicitudes
DB_URL=jdbc:mysql://mesatech-rds-solicitudes.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:3306/solicitudes_db
DB_USER=solicitudes_app
DB_PASS=clave_ficticia_solicitudes

# IP PRIVADA de la EC2 C (RabbitMQ)
RABBITMQ_HOST=10.0.0.30
RABBITMQ_PORT=5672
RABBITMQ_VHOST=mesatech
RABBITMQ_USER=solicitudes_consumer
RABBITMQ_PASS=clave_ficticia_consumidor
RABBITMQ_QUEUE=solicitudes.catalogo.queue

# Demo: demora por mensaje en ms (0 = sin demora)
CONSUMER_DELAY_MS=0
