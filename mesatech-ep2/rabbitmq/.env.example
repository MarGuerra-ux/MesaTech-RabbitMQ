# Copiar a .env y reemplazar con valores reales:  cp .env.example .env && chmod 600 .env
# NUNCA subir .env al repositorio (está en .gitignore)

# Administrador del broker (solo para la interfaz de gestión, no lo usan las aplicaciones)
RABBITMQ_ADMIN_USER=mesatech_admin
RABBITMQ_ADMIN_PASS=cambiar_esta_clave_admin

# Usuario de aplicación del publicador (microservicio Catálogo, EC2 A)
RABBITMQ_PUBLISHER_USER=catalogo_publisher
RABBITMQ_PUBLISHER_PASS=cambiar_esta_clave_publicador

# Usuario de aplicación del consumidor (microservicio Solicitudes, EC2 B)
RABBITMQ_CONSUMER_USER=solicitudes_consumer
RABBITMQ_CONSUMER_PASS=cambiar_esta_clave_consumidor
