# Copiar a .env (mismo directorio del jar) y completar. NO subir .env al repositorio.
# Sin comillas y sin los caracteres # \ ni espacios en las claves.
SERVER_PORT=8081

# Endpoint de la instancia RDS exclusiva de Catálogo
DB_URL=jdbc:mysql://mesatech-rds-catalogo.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:3306/catalogo_db
DB_USER=catalogo_app
DB_PASS=clave_ficticia_catalogo

# IP PRIVADA de la EC2 C (RabbitMQ)
RABBITMQ_HOST=10.0.0.30
RABBITMQ_PORT=5672
RABBITMQ_VHOST=mesatech
RABBITMQ_USER=catalogo_publisher
RABBITMQ_PASS=clave_ficticia_publicador
RABBITMQ_EXCHANGE=catalogo.exchange
RABBITMQ_ROUTING_KEY=categoria.creada
