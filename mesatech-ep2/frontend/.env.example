# Copiar a .env y completar con los IDs de su tenant (Entra ID). No subir .env al repositorio.
# Aplicación SPA (frontend) registrada en Entra ID
REACT_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Id. de directorio (inquilino)
REACT_APP_TENANT_ID=00000000-0000-0000-0000-000000000000
# Ámbito de la API expuesta (api-cloud-native)
REACT_APP_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
REACT_APP_REDIRECT_URI=http://localhost:3000/
# URL de invocación de AWS API Gateway (sin "/" final). React SOLO llama a esta URL.
REACT_APP_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
