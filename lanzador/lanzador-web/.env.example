# Copiar a .env y completar. NO subir .env al repositorio.
# Aplicación SPA registrada en Entra ID (redirect http://localhost:3000/)
REACT_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Id. de directorio (inquilino)
REACT_APP_TENANT_ID=00000000-0000-0000-0000-000000000000
# Ámbito expuesto por la API (api-cloud-native)
REACT_APP_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
REACT_APP_REDIRECT_URI=http://localhost:3000/
# Panel de RabbitMQ (EC2 C) para abrirlo desde el lanzador. Cambia al reiniciar el laboratorio.
REACT_APP_RABBIT_URL=http://1.2.3.4:15672/#/queues/mesatech/solicitudes.catalogo.queue
